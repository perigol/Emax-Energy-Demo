generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GESTOR
  FACTURAS
}

enum ContactKind {
  CLIENT
  SUPPLIER
  BOTH
}

enum OperationType {
  NACIONAL
  INTRACOMUNITARIA_BIENES
  INTRACOMUNITARIA_SERVICIOS
  INVERSION_SUJETO_PASIVO
}

enum IssuedStatus {
  BORRADOR
  EMITIDA
  COBRADA_PARCIAL
  COBRADA
}

enum BookStatus {
  BORRADOR
  REGISTRADA
  PAGADA
}

enum QuoteStatus {
  ABIERTO
  CONVERTIDO
}

enum PayDirection {
  IN
  OUT
}

model QuarterSettlement {
  id        String   @id @default(cuid())
  year      Int
  quarter   Int
  settledAt DateTime @default(now())
  snapshot  Json

  @@unique([year, quarter])
}

model Organization {
  id            String  @id @default(cuid())
  legalName     String
  nif           String
  fiscalAddress String
  logoData      Bytes?
  logoMime      String?
  vatRegime     String  @default("GENERAL")
  roiRegistered Boolean @default(false)
  invoiceSeries String  @default("NL")
  nextNumber    Int     @default(1)
  nextQuote     Int     @default(1)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  userId    String?
  userName  String
  userEmail String   @default("")
  summary   String

  @@index([at])
}

model Contact {
  id              String           @id @default(cuid())
  name            String
  nif             String
  country         String           @default("ES")
  vatNumber       String?
  kind            ContactKind
  email           String?
  address         String?
  isProfessional  Boolean          @default(false)
  defaultIrpfRate Decimal?         @db.Decimal(5, 2)
  issued          IssuedInvoice[]
  received        ReceivedInvoice[]
  quotes          Quote[]
}

model ServiceItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     Int
}

model IssuedInvoice {
  id           String              @id @default(cuid())
  series       String?
  number       Int?
  contactId    String
  contact      Contact             @relation(fields: [contactId], references: [id])
  issueDate    DateTime            @db.Date
  dueDate      DateTime?           @db.Date
  status       IssuedStatus        @default(BORRADOR)
  operation    OperationType
  rectifiesId  String?
  rectifies    IssuedInvoice?      @relation("Rectifies", fields: [rectifiesId], references: [id])
  rectifiedBy  IssuedInvoice[]     @relation("Rectifies")
  base         Decimal             @db.Decimal(12, 2)
  vat          Decimal             @db.Decimal(12, 2)
  irpfWithheld Decimal             @default(0) @db.Decimal(12, 2)
  total        Decimal             @db.Decimal(12, 2)
  paidAmount   Decimal             @default(0) @db.Decimal(12, 2)
  lines        IssuedInvoiceLine[]
  payments     Payment[]
  quote        Quote?
  createdAt    DateTime            @default(now())
}

model Quote {
  id               String        @id @default(cuid())
  number           Int
  contactId        String
  contact          Contact       @relation(fields: [contactId], references: [id])
  date             DateTime      @db.Date
  validUntil       DateTime?     @db.Date
  operation        OperationType
  status           QuoteStatus   @default(ABIERTO)
  base             Decimal       @db.Decimal(12, 2)
  vat              Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  issuedInvoiceId  String?       @unique
  issuedInvoice    IssuedInvoice? @relation(fields: [issuedInvoiceId], references: [id])
  lines            QuoteLine[]
  createdAt        DateTime      @default(now())
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  concept   String
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  vatRate   Int
  base      Decimal @db.Decimal(12, 2)
  vatAmount Decimal @db.Decimal(12, 2)
}

model IssuedInvoiceLine {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   IssuedInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  concept   String
  quantity  Decimal       @db.Decimal(12, 2)
  unitPrice Decimal       @db.Decimal(12, 2)
  vatRate   Int
  base      Decimal       @db.Decimal(12, 2)
  vatAmount Decimal       @db.Decimal(12, 2)
}

model ReceivedInvoice {
  id            String        @id @default(cuid())
  supplierId    String
  supplier      Contact       @relation(fields: [supplierId], references: [id])
  number        String
  date          DateTime      @db.Date
  operation     OperationType
  concept       String
  base          Decimal       @db.Decimal(12, 2)
  vatRate       Int
  vat           Decimal       @db.Decimal(12, 2)
  vatDeductible Boolean       @default(true)
  irpfWithheld  Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        BookStatus    @default(REGISTRADA)
  fileName      String?
  fileMime      String?
  fileData      Bytes?
  payments      Payment[]
  createdAt     DateTime      @default(now())
}

model Expense {
  id            String        @id @default(cuid())
  supplierName  String
  category      String
  number        String?
  date          DateTime      @db.Date
  operation     OperationType @default(NACIONAL)
  concept       String
  base          Decimal       @db.Decimal(12, 2)
  vatRate       Int
  vat           Decimal       @db.Decimal(12, 2)
  vatDeductible Boolean       @default(false)
  irpfWithheld  Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        BookStatus    @default(REGISTRADA)
  fileName      String?
  fileMime      String?
  fileData      Bytes?
  payments      Payment[]
  createdAt     DateTime      @default(now())
}

model BankAccount {
  id        String         @id @default(cuid())
  name      String
  iban      String
  currency  String         @default("EUR")
  movements BankMovement[]
}

model BankMovement {
  id        String      @id @default(cuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  concept   String
  amount    Decimal     @db.Decimal(12, 2)
  reference String?
  payment   Payment?

  @@unique([accountId, reference])
}

model Payment {
  id                String           @id @default(cuid())
  direction         PayDirection
  amount            Decimal          @db.Decimal(12, 2)
  date              DateTime         @db.Date
  issuedInvoiceId   String?
  issuedInvoice     IssuedInvoice?   @relation(fields: [issuedInvoiceId], references: [id])
  receivedInvoiceId String?
  receivedInvoice   ReceivedInvoice? @relation(fields: [receivedInvoiceId], references: [id])
  expenseId         String?
  expense           Expense?         @relation(fields: [expenseId], references: [id])
  bankMovementId    String?          @unique
  bankMovement      BankMovement?    @relation(fields: [bankMovementId], references: [id])
}
